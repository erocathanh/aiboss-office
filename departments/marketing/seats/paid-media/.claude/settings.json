{
  "_comment_pcn_v3": "PCN seat frame v3 hooks merge placeholder (reserved until 17/10)",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "Bash",
      "mcp__agent-broker__*"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(chmod 777:*)",
      "Edit(projects/**/references/**)",
      "Edit(projects/**/templates/**)",
      "Edit(projects/**/inputs/**)",
      "Edit(//Users/**/projects/**/references/**)",
      "Edit(//Users/**/projects/**/templates/**)",
      "Edit(//Users/**/projects/**/inputs/**)",
      "Edit(//home/**/projects/**/references/**)",
      "Edit(//home/**/projects/**/templates/**)",
      "Edit(//home/**/projects/**/inputs/**)",
      "Edit(operations/data/**)",
      "Edit(//Users/**/operations/data/**)",
      "Edit(//home/**/operations/data/**)",
      "Bash(rm:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/aiboss-office/**)",
      "Bash(python3 tools/inbox-reader/save_token.py *)",
      "Bash(/usr/bin/python3 tools/inbox-reader/save_token.py *)",
      "Bash(python3 tools/inbox-reader/fetch_page_messages.py *)",
      "Bash(/usr/bin/python3 tools/inbox-reader/fetch_page_messages.py *)",
      "Read(~/.meta-token-fanpage)",
      "Read(~/.fb-user-token-long)",
      "Read(~/.cloudflare*)",
      "Read(~/.vercel*/**)",
      "Read(~/ai-agent/*/khoa/**)",
      "Read(**/.env*)",
      "Bash(python3 ~/.claude/skills/doc-comment-fanpage/*)",
      "Bash(/usr/bin/python3 ~/.claude/skills/doc-comment-fanpage/*)",
      "Bash(python3 ~/.claude/skills/tra-loi-inbox-fanpage/*)",
      "Bash(/usr/bin/python3 ~/.claude/skills/tra-loi-inbox-fanpage/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_mass_delete.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_secret_leak.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_external_scan.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/protect_final_outputs.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/guard_customer_pii.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/guard_bulk_send.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/lock_raw_inputs.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_ollama.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_ad_account_write.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/block_public_publish.py\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/../../../../operations/hooks/remind_cross_check.py\""
          }
        ]
      }
    ]
  }
}
